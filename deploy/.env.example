# ##############################################################################
# Wikibase Suite deployment - initial configuration
#
# Copy to .env and fill in. See README.md in this directory for the runbook.
#
# Values in .env are INITIAL SETUP values. After the first
# `docker compose up`, changing most of them requires resetting the instance
# (see README.md, "Resetting").
#
# WARNING: Do not add comments on the same line as env vars: in some
# environments they will be included in the var!
# ##############################################################################

# Hostnames the two services are reached at. Required.
# LAN examples (add to your router DNS, Pi-hole, or clients' /etc/hosts):
#   WIKIBASE_PUBLIC_HOST=wikibase.lan
#   WDQS_PUBLIC_HOST=query.wikibase.lan
# Public examples:
#   WIKIBASE_PUBLIC_HOST=wikibase.yourdomain.example
#   WDQS_PUBLIC_HOST=query.wikibase.yourdomain.example

WIKIBASE_PUBLIC_HOST=
WDQS_PUBLIC_HOST=

# URL scheme. Keep http for LAN-only deployment (the default and the
# privacy-first choice). Set to https only together with
# docker-compose.https.yml. Baked into the WDQS concept URI at first boot.

PUBLIC_SCHEME=http

# Host port the reverse proxy listens on (http).

HTTP_PORT=80

# MediaWiki (Wikibase) admin user, created on first boot.
# All three variables must be set for the install to proceed.
# MediaWiki requires the password to be at least 10 characters.

MW_ADMIN_NAME=admin
MW_ADMIN_EMAIL=
MW_ADMIN_PASS=

# Database configuration.
# DB_NAME and DB_USER can keep their defaults. DB_PASS must be set.

DB_PASS=
DB_NAME=my_wiki
DB_USER=sqluser

# Anonymous usage-metadata callback to Wikimedia Deutschland (upstream
# defaults this to true). Kept OFF here: privacy first, no data to third
# parties without explicit instruction. Unlike the values
# above, this can be changed after initial setup.

METADATA_CALLBACK=false
