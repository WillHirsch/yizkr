# Artifact assertions: everything each artifact (or fragment) asserts —
# the inventory behind one-click verification (ADR-0003): statement →
# reference → fragment. Useful when re-examining a source.
SELECT ?artifact ?artifactLabel ?entityLabel ?propertyLabel ?value ?valueLabel
WHERE {
  ?statement prov:wasDerivedFrom ?reference .
  ?reference pr:{P:stated_in} ?artifact .
  ?entity ?p ?statement .
  ?property wikibase:claim ?p ;
            wikibase:statementProperty ?ps .
  ?statement ?ps ?value .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" . }
}
ORDER BY ?artifactLabel ?entityLabel ?propertyLabel
