# Under-witnessed machine statements — the reappraisal QUEUE (ADR-0022), the
# structural COMPLEMENT of the disagreement report. This is NOT a defect
# report and NOT a contentiousness ranking: it lists machine-written
# statements that entered with LOW SCRUTINY — a single stated-in source and
# no curator statement beside them on the same subject+property — so a
# reviewer can re-appraise them. It measures UNDER-WITNESSING, which can
# invert true contentiousness (a crisp single-source read looks high-priority;
# a corroborated coin-flip looks low), and it cannot see predicate-axis doubt.
# Coexistence is a healthy resting state (ADR-0002): a well-witnessed or
# curator-touched value is deliberately absent. Bulk-accepted writes are the
# sharpest subset; that disposition lives in the reviewed CSV and MediaWiki
# history (ADR-0022), not the graph. Scope it by adding a VALUES filter, e.g.
# `VALUES ?prop { wd:{P:birth_name} wd:{P:married_name} }` for the name case.
SELECT DISTINCT ?subject ?subjectLabel ?propertyLabel ?value ?valueLabel ?source
WHERE {
  ?prop wikibase:claim ?p ;
        wikibase:statementProperty ?ps ;
        rdfs:label ?propertyLabel .
  FILTER(LANG(?propertyLabel) = "en")
  ?subject ?p ?st .
  ?st ?ps ?value .
  # machine-written: this statement is derived from an extraction run
  ?st prov:wasDerivedFrom/pr:{P:inferred_from_extraction_run} ?run .
  # under-corroborated: exactly one distinct stated-in source (no agreeing
  # second source has been added, cf. writer's additional-source path)
  ?st prov:wasDerivedFrom/pr:{P:stated_in} ?source .
  FILTER NOT EXISTS {
    ?st prov:wasDerivedFrom/pr:{P:stated_in} ?source2 .
    FILTER(?source2 != ?source)
  }
  # no curator sibling: a human write carries NO extraction-run reference
  # (ADR-0003), so a curator statement on the same subject+property would
  # count as a witness — its absence is what makes this one under-witnessed
  FILTER NOT EXISTS {
    ?subject ?p ?curatorSt .
    FILTER(?curatorSt != ?st)
    FILTER NOT EXISTS {
      ?curatorSt prov:wasDerivedFrom/pr:{P:inferred_from_extraction_run} ?anyRun .
    }
  }
  OPTIONAL { ?subject rdfs:label ?subjectLabel . FILTER(LANG(?subjectLabel) = "en") }
  OPTIONAL { ?value rdfs:label ?valueLabel . FILTER(LANG(?valueLabel) = "en") }
}
ORDER BY ?subjectLabel ?propertyLabel
