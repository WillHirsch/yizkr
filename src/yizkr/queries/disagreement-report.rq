# Disagreement report — the flagship R2 view, as the values it compares:
# every statement of the compared properties, one row per stated-in
# source, listing side by side the values that different sources attribute
# to one entity and property. Coexisting values are a HEALTHY RESTING
# STATE (ADR-0002), not errors: the report exists so a reader can weigh
# the evidence, never to pick a value or "fix" one.
#
# The compared properties are the ones that hold at most one true value
# per subject (dates and places of birth and death, parents, birth name,
# an entity's own point in time, start and end, a document's inception, a
# place's identity), and residence and spouse, whose dates are compared.
# Each row gives the statement's rank, its value as the source states it
# (a time with its precision; an item with the label of the item a merge
# redirect resolves to), the earliest and latest dates the source gives
# it, the start time, end time and point in time it carries as qualifiers,
# the latest start date and earliest end date that bound a residence's or
# a marriage's start and end, and each stated-in source with the artifact
# it belongs to (a page fragment belongs to the artifact it is part of). A
# statement with no stated-in source shows no source. Each time comes with
# the calendar model its value node states, which the comparison checks: a
# date before the common era or in a calendar other than the proleptic
# Gregorian stops the report (ADR-0034).
#
# The comparison runs in Python, in yizkr.disagreement (ADR-0033): it
# pairs the values that different artifacts attribute and sets aside
# differences of resolution, using these rows and the recorded place
# containment (place-containment.rq). MODELING.md "Contradictions" states
# its rules.
SELECT ?entity ?entityLabel ?property ?propertyLabel ?statement ?rank
       ?value ?valueLabel ?precision ?calendar
       ?earliest ?earliestPrecision ?earliestCalendar
       ?latest ?latestPrecision ?latestCalendar
       ?latestStart ?latestStartPrecision ?latestStartCalendar
       ?earliestEnd ?earliestEndPrecision ?earliestEndCalendar
       ?start ?startPrecision ?startCalendar
       ?end ?endPrecision ?endCalendar
       ?pointInTime ?pointInTimePrecision ?pointInTimeCalendar
       ?source ?sourceLabel ?artifact
WHERE {
  # the properties that hold at most one true value per subject, and the
  # two that accumulate values over a life but are dated (residence and
  # spouse)
  VALUES ?property {
    wd:{P:date_of_birth} wd:{P:date_of_death}
    wd:{P:place_of_birth} wd:{P:place_of_death}
    wd:{P:father} wd:{P:mother}
    wd:{P:birth_name}
    wd:{P:point_in_time} wd:{P:start_time} wd:{P:end_time}
    wd:{P:inception}
    wd:{P:coordinate_location} wd:{P:geonames_id} wd:{P:whg_place_id}
    wd:{P:residence} wd:{P:spouse}
  }
  ?property wikibase:claim ?p ;
            wikibase:statementProperty ?ps ;
            wikibase:statementValue ?psv .
  # the qualifiers read below, each bound once here so that every lookup
  # below joins on the statement alone
  wd:{P:earliest_date} wikibase:qualifierValue ?earliestLink .
  wd:{P:latest_date} wikibase:qualifierValue ?latestLink .
  wd:{P:latest_start_date} wikibase:qualifierValue ?latestStartLink .
  wd:{P:earliest_end_date} wikibase:qualifierValue ?earliestEndLink .
  wd:{P:start_time} wikibase:qualifierValue ?startLink .
  wd:{P:end_time} wikibase:qualifierValue ?endLink .
  wd:{P:point_in_time} wikibase:qualifierValue ?pointInTimeLink .
  # every statement, whatever its rank: rank is a curator's overlay,
  # which the comparison reads
  ?entity ?p ?statement .
  ?statement ?ps ?value ;
             wikibase:rank ?rank .
  # a time's stated precision and its calendar model
  OPTIONAL { ?statement ?psv ?valueNode .
             ?valueNode wikibase:timePrecision ?precision .
             OPTIONAL { ?valueNode wikibase:timeCalendarModel ?calendar . } }
  # the range its source states, and the dates it carries: a residence's or
  # a marriage's start and end, each with the bounds of its own (from the
  # earliest date to the latest start date, from the earliest end date to
  # the latest date), and an observation's point in time
  OPTIONAL { ?statement ?earliestLink ?earliestNode .
             ?earliestNode wikibase:timeValue ?earliest ;
                           wikibase:timePrecision ?earliestPrecision .
             OPTIONAL { ?earliestNode wikibase:timeCalendarModel
                          ?earliestCalendar . } }
  OPTIONAL { ?statement ?latestLink ?latestNode .
             ?latestNode wikibase:timeValue ?latest ;
                         wikibase:timePrecision ?latestPrecision .
             OPTIONAL { ?latestNode wikibase:timeCalendarModel
                          ?latestCalendar . } }
  OPTIONAL { ?statement ?latestStartLink ?latestStartNode .
             ?latestStartNode wikibase:timeValue ?latestStart ;
                              wikibase:timePrecision ?latestStartPrecision .
             OPTIONAL { ?latestStartNode wikibase:timeCalendarModel
                          ?latestStartCalendar . } }
  OPTIONAL { ?statement ?earliestEndLink ?earliestEndNode .
             ?earliestEndNode wikibase:timeValue ?earliestEnd ;
                              wikibase:timePrecision ?earliestEndPrecision .
             OPTIONAL { ?earliestEndNode wikibase:timeCalendarModel
                          ?earliestEndCalendar . } }
  OPTIONAL { ?statement ?startLink ?startNode .
             ?startNode wikibase:timeValue ?start ;
                        wikibase:timePrecision ?startPrecision .
             OPTIONAL { ?startNode wikibase:timeCalendarModel
                          ?startCalendar . } }
  OPTIONAL { ?statement ?endLink ?endNode .
             ?endNode wikibase:timeValue ?end ;
                      wikibase:timePrecision ?endPrecision .
             OPTIONAL { ?endNode wikibase:timeCalendarModel
                          ?endCalendar . } }
  OPTIONAL { ?statement ?pointInTimeLink ?pointInTimeNode .
             ?pointInTimeNode wikibase:timeValue ?pointInTime ;
                              wikibase:timePrecision ?pointInTimePrecision .
             OPTIONAL { ?pointInTimeNode wikibase:timeCalendarModel
                          ?pointInTimeCalendar . } }
  # every stated-in source, with its label and the artifact it belongs to
  OPTIONAL { ?statement prov:wasDerivedFrom ?reference .
             ?reference pr:{P:stated_in} ?source .
             OPTIONAL { ?source wdt:{P:instance_of} wd:{Q:artifact_fragment} ;
                                wdt:{P:part_of} ?whole . }
             OPTIONAL { ?source rdfs:label ?sourceLabel .
                        FILTER(LANG(?sourceLabel) = "en") }
             BIND(COALESCE(?whole, ?source) AS ?artifact) }
  # labels bound directly; an item value's label is its merge target's,
  # and literals have none
  OPTIONAL { ?entity rdfs:label ?entityLabel .
             FILTER(LANG(?entityLabel) = "en") }
  OPTIONAL { ?property rdfs:label ?propertyLabel .
             FILTER(LANG(?propertyLabel) = "en") }
  OPTIONAL { ?value <http://www.w3.org/2002/07/owl#sameAs>?/rdfs:label ?valueLabel .
             FILTER(LANG(?valueLabel) = "en") }
}
