# Disagreement report — the flagship R2 view.
# Every entity+property carrying two or more different attributed values,
# with the source each value is stated in. Contradictions shown here are a
# HEALTHY RESTING STATE (ADR-0002), not errors: this report exists so a
# reader can weigh the evidence, not so someone can "fix" it.
#
# Only properties that can hold at most one true value per person are
# candidates for disagreement. Properties that legitimately accumulate
# values over a life (spouse, residence, ...) are excluded — two spouses
# from one source are remarriages, not a contradiction.
SELECT DISTINCT ?entity ?entityLabel ?propertyLabel
       ?valueA ?valueALabel ?precisionA ?sourceALabel
       ?valueB ?valueBLabel ?precisionB ?sourceBLabel
WHERE {
  VALUES ?property {
    wd:{P:date_of_birth} wd:{P:date_of_death}
    wd:{P:place_of_birth} wd:{P:place_of_death}
    wd:{P:father} wd:{P:mother}
    wd:{P:coordinate_location} wd:{P:geonames_id} wd:{P:whg_place_id}
  }
  ?property wikibase:claim ?p ;
            wikibase:statementProperty ?ps .
  ?entity ?p ?stA , ?stB .
  ?stA ?ps ?rawValueA .
  ?stB ?ps ?rawValueB .
  # canonicalize through item-merge redirects: a statement written
  # before a merge still points at the redirect, and that indirection
  # is not a disagreement
  OPTIONAL { ?rawValueA <http://www.w3.org/2002/07/owl#sameAs> ?canonicalA . }
  OPTIONAL { ?rawValueB <http://www.w3.org/2002/07/owl#sameAs> ?canonicalB . }
  BIND(COALESCE(?canonicalA, ?rawValueA) AS ?valueA)
  BIND(COALESCE(?canonicalB, ?rawValueB) AS ?valueB)
  FILTER(?valueA != ?valueB)
  FILTER(STR(?stA) < STR(?stB))
  # stated precision for time values: display must never pad or narrow
  OPTIONAL { ?stA ?vpA ?nodeA .
             ?nodeA wikibase:timeValue ?rawValueA ;
                    wikibase:timePrecision ?precisionA . }
  OPTIONAL { ?stB ?vpB ?nodeB .
             ?nodeB wikibase:timeValue ?rawValueB ;
                    wikibase:timePrecision ?precisionB . }
  OPTIONAL { ?stA prov:wasDerivedFrom/pr:{P:stated_in} ?sourceA . }
  OPTIONAL { ?stB prov:wasDerivedFrom/pr:{P:stated_in} ?sourceB . }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" . }
}
ORDER BY ?entityLabel ?propertyLabel
