# Per-person timeline: every dated assertion about each person, with the
# source that asserts it. Plural-by-default (R6): when sources disagree
# about a date, ALL attributed values appear as separate rows, labeled by
# source — nothing is silently picked.
# Covers: dated statements on the person (birth, death, ...), dated
# qualifiers on the person's statements (e.g. spouse with point in time),
# and dated events the person participated in.
# For a single person, append e.g.: FILTER(?person = wd:Q26)
#defaultView:Timeline
SELECT DISTINCT ?person ?personLabel ?what ?date ?precision ?source ?sourceLabel
WHERE {
  ?person wdt:{P:instance_of} wd:{Q:human} .
  {
    BIND("date of birth"@en AS ?what)
    ?person p:{P:date_of_birth} ?st .
    ?st ps:{P:date_of_birth} ?date .
  } UNION {
    BIND("date of death"@en AS ?what)
    ?person p:{P:date_of_death} ?st .
    ?st ps:{P:date_of_death} ?date .
  } UNION {
    # dated qualifiers: an instant (point in time) or the start/end of a
    # state (marriage start, residence end, ...)
    VALUES ?dateQualifier {
      pq:{P:point_in_time} pq:{P:start_time} pq:{P:end_time}
    }
    ?person ?p ?st .
    ?st ?dateQualifier ?date .
    ?claimProperty wikibase:claim ?p ;
                   rdfs:label ?what .
    FILTER(LANG(?what) = "en")
  } UNION {
    ?event wdt:{P:participant} ?person ;
           wdt:{P:instance_of} ?eventType ;
           p:{P:point_in_time} ?st .
    ?st ps:{P:point_in_time} ?date .
    ?eventType rdfs:label ?what .
    FILTER(LANG(?what) = "en")
  }
  # the date's stated precision (works for statement and qualifier value
  # nodes alike): display must never pad what a source said
  OPTIONAL {
    ?st ?anyValuePredicate ?valueNode .
    ?valueNode wikibase:timeValue ?date ;
               wikibase:timePrecision ?precision .
  }
  OPTIONAL { ?st prov:wasDerivedFrom/pr:{P:stated_in} ?source . }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" . }
}
ORDER BY ?personLabel ?date
